# NAS：控制端口供 FRPC 转发，模型连接需按实际部署核对。
MEDIA_WEB_PORT=18213
QBITTORRENT_URL=http://127.0.0.1:8100
MEDIA_DATA_DIR=/data
CODEX_APP_SERVER_URL=ws://127.0.0.1:8108
CODEX_TOKEN_FILE=/system/codex/config/app-server-token

# 可选字幕来源：填写要启用的来源，留空跳过该来源；当前由 NAS worker 使用。
OPENSUBTITLES_API_KEY=
SUBDL_API_KEY=
ASSRT_API_KEY=
# 状态默认 ./state；自动使用 MEDIA_DATA_DIR 下的 downloads、media_hub。
# 不需要云端地址。
# 下载器要求登录或需要改默认值时，再查 docs/split-deployment.md。
