# 统一模板：两端各自复制为 .env，只填写本机负责的分组。
# 现有 .env 不会被覆盖；已有自定义状态目录须保留，模板不会迁移旧数据库。
# 当前后端仅支持 SQLite，尚不能直接连接旧 MySQL；旧库复用仍待实现。

# ===== cloud：网站、MCP、媒体搜索、Jackett =====
# 云端网站与 NAS 控制端用不同变量，避免同一模板出现重复赋值。
MEDIA_GATEWAY_PORT=18214
MEDIA_MCP_PORT=18210
# 云端本机 FRP 映射端口 -> NAS 的 MEDIA_LOCAL_CONTROL_PORT。
MEDIA_CONTROL_PORT=28213
TMDB_API_KEY=
# 已有 Jackett 填地址，留空才启动内置；固定 /root/container_cache/jackett。
JACKETT_URL=

# ===== local / NAS：控制、下载器、模型、文件处理 =====
MEDIA_LOCAL_CONTROL_PORT=18213
QBITTORRENT_URL=http://127.0.0.1:8100
MEDIA_DATA_DIR=/data
CODEX_APP_SERVER_URL=ws://127.0.0.1:8108
CODEX_TOKEN_FILE=/system/codex/config/app-server-token

# 可选：已有下载器要求登录时填写真实账号，不会尝试默认密码。
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=
# 可选字幕来源：由 NAS worker 使用；留空跳过对应来源。
OPENSUBTITLES_API_KEY=
SUBDL_API_KEY=
ASSRT_API_KEY=
# 可选通知：已有完整 Bark 推送地址时填写，留空只记录本地通知。
BARK_URL=

# 自动使用 MEDIA_DATA_DIR 下的 downloads、media_hub；状态默认 ./state、./state-cloud。
# 不用填写域名、内部 URL、内部 token、Jackett 缓存目录。
# 传统个人 LAN 单机模式默认免认证；cloud MCP 仍使用用户令牌。
MEDIA_AUTH_MODE=none
# Docker bridge 反代等条件配置见 docs/split-deployment.md。
