# 两端各自复制为 .env；已有 .env 不覆盖，状态目录和媒体路径不自动迁移。
# 新名称按所属端分类；旧名称仍兼容，映射表见 docs/service-names.md。

# ===== cloud / 网站入口（cloud-web） =====
MEDIA_CLOUD_WEB_BIND=0.0.0.0
MEDIA_CLOUD_WEB_PORT=18214
# Docker bridge 反代时额外填写 MEDIA_PROXY_IPS=反代容器实际来源IP。

# ===== cloud / MCP 入口（cloud-mcp） =====
MEDIA_CLOUD_MCP_PORT=18210

# ===== cloud / 本机 FRP 入口 -> NAS local-control =====
# 这是云端本机的映射端口，不是 NAS 的监听端口。
MEDIA_CLOUD_CONTROL_PORT=28213
MEDIA_CLOUD_STATE_PATH=./state-cloud

# ===== cloud / 搜索依赖 =====
TMDB_API_KEY=
# 已有 Jackett 填地址，留空启动内置；缓存固定在 /root/container_cache/jackett。
JACKETT_URL=

# ===== local / NAS 控制 API（local-control） =====
MEDIA_LOCAL_CONTROL_BIND=192.168.8.1
MEDIA_LOCAL_CONTROL_PORT=18213

# ===== local / NAS 文件与 SQLite 状态 =====
# 宿主机真实目录，整体挂载到容器 /data；不是容器内目录配置。
MEDIA_LOCAL_DATA_DIR=/data
MEDIA_LOCAL_STATE_PATH=./state
# 容器内默认下载 /data/downloads、整理 /data/media_hub。
# SQLite 状态目录必须在 NAS 本地磁盘；当前不直接连接旧 MySQL。

# ===== local / NAS 下载器 =====
# 已有地址就复用；不会尝试默认密码或自动接管其他下载任务。
QBITTORRENT_URL=http://127.0.0.1:8100
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=

# ===== local / NAS 模型与字幕 worker（local-worker） =====
CODEX_APP_SERVER_URL=ws://127.0.0.1:8108
CODEX_TOKEN_FILE=/system/codex/config/app-server-token
OPENSUBTITLES_API_KEY=
SUBDL_API_KEY=
ASSRT_API_KEY=
# 可选通知：已有完整 Bark 推送地址时填写，留空只记录本地通知。
BARK_URL=

# ===== 传统个人 LAN 单机入口（local-mcp） =====
# setup.sh local 不启动它；只有显式单机部署才使用。
MEDIA_LOCAL_MCP_PORT=18210
MEDIA_AUTH_MODE=none
# 网站账户、HTTP 会话与反代安全策略由共用 HTTP 配置管理，见两端部署说明。
# 不需要填写域名、内部 URL、内部 token 或 Jackett 缓存目录。
