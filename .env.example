# 传统单机模板；云端/NAS 分离部署请分别用 .env.cloud.example、.env.local.example。
# 默认个人 LAN MCP 免登录；多人或公网部署请按 docs/deployment.md 显式配置。
MEDIA_AUTH_MODE=none
TMDB_API_KEY=
CODEX_TOKEN_FILE=./state/codex-token
# 可选字幕来源；留空跳过对应来源。
OPENSUBTITLES_API_KEY=
SUBDL_API_KEY=
ASSRT_API_KEY=
# 默认媒体 ./data/{downloads,media_hub}，状态 ./state，模型 ws://127.0.0.1:8108。
# 下载器和 Jackett 默认按需启动内置服务；复用已有服务等高级选项见 docs/deployment.md。
