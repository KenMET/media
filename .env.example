# Copy to .env on each host. Do not overwrite existing .env files or automatically migrate state/media paths.
# Names are grouped by deployment role; legacy names remain supported. See docs/service-names.md.

# ===== cloud / Web entrypoint (cloud-web) =====
MEDIA_CLOUD_WEB_BIND=0.0.0.0
MEDIA_CLOUD_WEB_PORT=18214
# For a Docker bridge reverse proxy, set MEDIA_PROXY_IPS to its actual source IP.

# ===== cloud / MCP entrypoint (cloud-mcp) =====
MEDIA_CLOUD_MCP_PORT=18210

# ===== cloud / Local FRP entrypoint -> NAS local-control =====
# This is the mapping port on the cloud host, not the NAS listening port.
MEDIA_CLOUD_CONTROL_PORT=28213
MEDIA_CLOUD_STATE_PATH=./state-cloud

# ===== cloud / Search dependencies =====
TMDB_API_KEY=
# Set an existing Jackett URL or leave empty to start the bundled service; cache is fixed at /root/container_cache/jackett.
JACKETT_URL=

# ===== local / NAS control API (local-control) =====
MEDIA_LOCAL_CONTROL_BIND=192.168.8.1
MEDIA_LOCAL_CONTROL_PORT=18213

# ===== local / NAS files and SQLite state =====
# Real host directory mounted at /data in the container; not an in-container directory setting.
MEDIA_LOCAL_DATA_DIR=/data
MEDIA_LOCAL_STATE_PATH=./state
# Container defaults: downloads at /data/downloads, library at /data/media_hub.
# SQLite state must reside on a local NAS disk; legacy MySQL is not connected directly.

# ===== local / NAS downloader =====
# Reuse the configured URL; never try default passwords or adopt unrelated downloads.
QBITTORRENT_URL=http://127.0.0.1:8100
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=

# ===== local / NAS model and subtitle worker (local-worker) =====
CODEX_APP_SERVER_URL=ws://127.0.0.1:8108
CODEX_TOKEN_FILE=/system/codex/config/app-server-token
OPENSUBTITLES_API_KEY=
SUBDL_API_KEY=
ASSRT_API_KEY=
# Optional notifications: set a full existing Bark push URL; leave empty for local notification records only.
BARK_URL=

# ===== Legacy personal LAN standalone entrypoint (local-mcp) =====
# setup.sh local does not start it; only explicit standalone deployments use it.
MEDIA_LOCAL_MCP_PORT=18210
MEDIA_AUTH_MODE=none
# Web accounts, HTTP sessions and reverse proxy policy use shared HTTP settings. See the split deployment guide.
# No domain, internal URL, internal token or Jackett cache directory needs to be entered.
