# Personal LAN deployment: no database account and no MCP login key.
MEDIA_AUTH_MODE=none
# Keep this wildcard default for the bundled host/bridge networking profile.
# Use the host firewall to restrict 18210/18211/18212 to your trusted LAN.
MEDIA_LAN_BIND=0.0.0.0
# Optional display address; not a listener/firewall setting.
MEDIA_LAN_IP=
# Optional narrow MCP client allowlist; actual socket peers only.
# MEDIA_LAN_CIDRS=127.0.0.0/8,192.168.8.0/24,::1/128
# Optional exact DNS names, no scheme, port, wildcard or URL path.
# IP literals and localhost work without this setting.
MEDIA_ALLOWED_HOSTS=
MEDIA_MCP_PORT=18210
MEDIA_QBITTORRENT_PORT=18211
MEDIA_JACKETT_PORT=18212
MEDIA_TORRENT_PORT=48181
# Keep SQLite on a local disk, not an SMB/NFS share.
MEDIA_STATE_PATH=./state
MEDIA_DATA_DIR=./data
MEDIA_SERVICES_DIR=./services
PUID=0
PGID=0
TZ=Asia/Shanghai
# Required existing authenticated model runtime; start.sh does not install it.
# Endpoint must implement the App Server WebSocket protocol expected by this project.
# CODEX_TOKEN_FILE is a HOST file path; its bearer token must match that endpoint.
CODEX_APP_SERVER_URL=ws://127.0.0.1:8108
CODEX_TOKEN_FILE=./state/codex-token
# External services still require their own API credentials, when enabled.
TMDB_API_KEY=
OPENSUBTITLES_API_KEY=
SUBDL_API_KEY=
ASSRT_API_KEY=
# Full device push endpoint, including the private device key. Leave empty for log-only.
BARK_URL=
SUBTITLE_ENABLE_AUDIO_ASR=false
SUBTITLE_SYNC_MODE=required
INSTALL_OCR=true
